{
   "action": {
      "default_icon": {
         "128": "icon128.png",
         "16": "icon16.png",
         "32": "icon32.png",
         "48": "icon48.png"
      },
      "default_popup": "popup.html",
      "default_title": "Skribbl Auto Guess And Draw"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "css": [ "styles.css", "auto-draw.css" ],
      "js": [ "content.js", "image-converter.js", "image-input.js", "auto-draw.js" ],
      "matches": [ "*://*.skribbl.io/*", "*://skribbl.io/*" ],
      "run_at": "document_idle"
   }, {
      "js": [ "draw-runner.js" ],
      "matches": [ "*://*.skribbl.io/*", "*://skribbl.io/*" ],
      "run_at": "document_idle",
      "world": "MAIN"
   } ],
   "description": "Smart skribbl.io guesses, local word learning, and drag-and-drop Auto Draw.",
   "host_permissions": [ "*://*.skribbl.io/*", "*://skribbl.io/*", "https://skribbl-word-sync.lakshithadil30.workers.dev/*" ],
   "icons": {
      "128": "icon128.png",
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Skribbl Auto Guess And Draw",
   "permissions": [ "storage" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "2.2.5",
   "web_accessible_resources": [ {
      "matches": [ "*://*.skribbl.io/*", "*://skribbl.io/*" ],
      "resources": [ "words.txt", "icon48.png" ]
   } ]
}
