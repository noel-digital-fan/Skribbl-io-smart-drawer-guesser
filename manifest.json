{
   "action": {
      "default_icon": {
         "16": "icon16.png",
         "32": "icon32.png",
         "48": "icon48.png",
         "128": "icon128.png"
      },
      "default_popup": "popup.html",
      "default_title": "Skribbl Smart Drawer/Guesser"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [
      {
         "css": [
            "branding.css",
            "styles.css",
            "auto-draw.css",
            "votekick.css"
         ],
         "js": [
            "word-catalog.js",
            "word-library.js",
            "panel-window.js",
            "content.js",
            "ultra-optimizer.js",
            "exact-raster-encoder.js",
            "background-band-encoder.js",
            "instant-planner.js",
            "image-converter.js",
            "image-input.js",
            "image-adjustments.js",
            "image-editor.js",
            "auto-draw.js",
            "votekick.js"
         ],
         "matches": [
            "*://*.skribbl.io/*",
            "*://skribbl.io/*"
         ],
         "run_at": "document_idle"
      },
      {
         "js": [
            "draw-runner.js"
         ],
         "matches": [
            "*://*.skribbl.io/*",
            "*://skribbl.io/*"
         ],
         "run_at": "document_idle",
         "world": "MAIN"
      },
      {
         "js": [
            "votekick-runner.js"
         ],
         "matches": [
            "*://*.skribbl.io/*",
            "*://skribbl.io/*"
         ],
         "run_at": "document_start",
         "world": "MAIN"
      }
   ],
   "description": "Smart skribbl.io guesses, local word learning, and Auto Draw with image drop and clipboard paste.",
   "host_permissions": [
      "*://*.skribbl.io/*",
      "*://skribbl.io/*",
      "https://skribbl-word-sync.lakshithadil30.workers.dev/*"
   ],
   "icons": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
   },
   "manifest_version": 3,
   "name": "Skribbl Smart Drawer/Guesser",
   "permissions": [
      "storage",
      "clipboardRead"
   ],
   "version": "1.0",
   "web_accessible_resources": [
      {
         "matches": [
            "*://*.skribbl.io/*",
            "*://skribbl.io/*"
         ],
         "resources": [
            "words.txt",
            "words-de.txt",
            "words-fr.txt",
            "words-ko.txt",
            "words-pl.txt",
            "words-es.txt",
            "icon48.png",
            "assets/doodle-blue.png",
            "assets/fonts/PixelifySans.ttf"
         ]
      }
   ],
   "short_name": "Skribbl Smart",
   "key": ""
}
